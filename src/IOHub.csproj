<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon) and the colour dialog; WinForms names are used qualified so they don't clash with WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFO0003 wants DPI set through WinForms; the manifest setting is what WPF uses, so it stays. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <RootNamespace>IOHub</RootNamespace>
    <Version>0.4.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Regenerate with tools/make_icon.py -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>IO Hub</Product>
    <!-- Windows shows FileDescription (AssemblyTitle) as the program's name, e.g. in Task Manager and on firewall rules. -->
    <AssemblyTitle>IO Hub</AssemblyTitle>
    <Company>DrangedAddons</Company>
    <Copyright>© 2026 DrangedAddons</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sidebar and dialog logo, tray icon; regenerate both with tools/make_icon.py -->
    <Resource Include="logo.png" />
    <Resource Include="app.ico" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Caps the young-object heap at 4 MB. On a CPU with a large cache .NET sizes it far bigger, and an app that
         sits in the tray all day doesn't need that: measured 89 MB → 46 MB after visiting every page. -->
    <RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="4194304" />
  </ItemGroup>

  <!-- dotnet publish -c Release  →  one self-contained IOHub.exe that runs without installing .NET -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Uncompressed on purpose. A compressed bundle unpacks every framework DLL into private memory (115 MB in the
         tray); uncompressed, they're mapped from the exe and Windows can share or drop them (30 MB). The exe is
         bigger to download (about 165 MB instead of 72 MB). -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
