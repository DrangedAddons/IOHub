<UserControl x:Class="IOHub.Pages.AddonsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- One card per addon, built in code (AddonsPage.xaml.cs). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="40,6,40,0">
            <TextBlock Text="Addons" Style="{StaticResource PageTitle}"/>
            <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Game addons that go with IO Hub's integrations. IO Hub carries them, installs them where you choose and keeps them up to date."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,24,0,0">
            <StackPanel x:Name="Cards" Margin="40,0,28,32" MaxWidth="820" HorizontalAlignment="Left"/>
        </ScrollViewer>
    </Grid>
</UserControl>
