<UserControl x:Class="IOHub.Pages.TriggersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:IOHub.Ui"
             PreviewKeyDown="Page_PreviewKeyDown">
    <!-- Rows and cards are built in code (TriggersPage.xaml.cs). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="40,6,40,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Triggers" Style="{StaticResource PageTitle}"/>
                <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="What switches profiles for you: a hotkey, a key gesture, or an integration like Steam Big Picture. They keep working with the window closed."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <!-- Layout switcher; each icon is a tiny drawing of the layout. -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="11" Padding="3" WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RowsLayout" Style="{StaticResource SegTab}" GroupName="TriggerLayout"
                                     Checked="Layout_Checked" ToolTip="One full-width row per trigger">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M0,1 h18 v3 h-18 z M0,6 h18 v3 h-18 z M0,11 h18 v3 h-18 z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2" VerticalAlignment="Center"/>
                                <TextBlock Text="Rows" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="CardsLayout" Style="{StaticResource SegTab}" GroupName="TriggerLayout"
                                     Checked="Layout_Checked" ToolTip="Cards side by side">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M0,1 h8 v5 h-8 z M10,1 h8 v5 h-8 z M0,8 h8 v5 h-8 z M10,8 h8 v5 h-8 z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2" VerticalAlignment="Center"/>
                                <TextBlock Text="Cards" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource AccentButton}" Margin="12,0,0,0" Click="New_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="New trigger" Margin="8,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,24,0,0">
            <StackPanel Margin="40,0,28,32">
                <TextBlock x:Name="PausedNote" Visibility="Collapsed" Foreground="{StaticResource WarnBrush}" Margin="2,0,0,14"
                           Text="Triggers are paused from the tray menu. Nothing below will fire until they're resumed."/>
                <ui:AdaptiveGrid x:Name="Cards" MinItemWidth="440" Margin="0,0,12,0"/>
                <Border x:Name="EmptyState" Style="{StaticResource Card}" Padding="40,44" Margin="0,0,12,0" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="480">
                        <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource AccentGradient}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="24" Foreground="White"/>
                        </Border>
                        <TextBlock Text="No triggers yet" Style="{StaticResource SectionTitle}" FontSize="18" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                                   Text="Add a hotkey like Ctrl + Alt + T, a double tap of Right Ctrl, or have Steam Big Picture switch to the TV and back on its own."/>
                        <Button Style="{StaticResource AccentButton}" Content="New trigger" FontWeight="SemiBold" HorizontalAlignment="Center"
                                Margin="0,24,0,0" Click="New_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
