<UserControl x:Class="IOHub.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:IOHub.Ui">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="40,6,40,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Overview" Style="{StaticResource PageTitle}"/>
                <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="This PC and the setups it can switch to. The lit line shows which one it's in right now."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <!-- Layout switcher; each icon is a tiny drawing of the layout it picks. -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="11" Padding="3" WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="FlowLayout" Style="{StaticResource SegTab}" GroupName="OverviewLayout"
                                     Checked="Layout_Checked" ToolTip="Flow: this PC on the left, profiles on the right">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M0,5 h5 v4 h-5 z M13,1 h5 v4 h-5 z M13,9 h5 v4 h-5 z M5,7 C9,7 9,3 13,3 M5,7 C9,7 9,11 13,11"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2" VerticalAlignment="Center"/>
                                <TextBlock Text="Flow" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="HubLayout" Style="{StaticResource SegTab}" GroupName="OverviewLayout"
                                     Checked="Layout_Checked" ToolTip="Hub: this PC in the middle, profiles either side">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M7,5 h4 v4 h-4 z M0,1 h4 v4 h-4 z M0,9 h4 v4 h-4 z M14,1 h4 v4 h-4 z M14,9 h4 v4 h-4 z M7,7 L4,3 M7,7 L4,11 M11,7 L14,3 M11,7 L14,11"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2" VerticalAlignment="Center"/>
                                <TextBlock Text="Hub" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TreeLayout" Style="{StaticResource SegTab}" GroupName="OverviewLayout"
                                     Checked="Layout_Checked" ToolTip="Tree: this PC on top, profiles underneath">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M7,0 h4 v4 h-4 z M0,10 h4 v4 h-4 z M7,10 h4 v4 h-4 z M14,10 h4 v4 h-4 z M9,4 L2,10 M9,4 L9,10 M9,4 L16,10"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2" VerticalAlignment="Center"/>
                                <TextBlock Text="Tree" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <Border x:Name="StatusChip" VerticalAlignment="Center" Margin="12,0,0,0" CornerRadius="10"
                        Padding="12,7" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Margin="9,0,0,0" FontWeight="SemiBold" FontSize="12.5"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Map -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="40,24,40,32" ClipToBounds="True">
            <Border.Background>
                <RadialGradientBrush Center="0.3,0.5" GradientOrigin="0.3,0.5" RadiusX="0.7" RadiusY="0.9">
                    <GradientStop Color="#181C26" Offset="0"/>
                    <GradientStop Color="#13161C" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
            <Grid>
                <!-- Faint dot grid behind the map -->
                <Grid.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,22,22" ViewportUnits="Absolute" Viewbox="0,0,22,22" ViewboxUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="Transparent">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,22,22"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#232833">
                                    <GeometryDrawing.Geometry>
                                        <EllipseGeometry Center="11,11" RadiusX="1" RadiusY="1"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Grid.Background>
                <!-- Width never scrolls: a layout wider than the window is scaled down to fit (see FitMap). -->
                <ScrollViewer x:Name="MapScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" SizeChanged="MapScroll_SizeChanged">
                    <ui:TopologyPanel x:Name="Map" MinHeight="420"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
