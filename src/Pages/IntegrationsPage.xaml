<UserControl x:Class="IOHub.Pages.IntegrationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Integrations are built in code (IntegrationsPage.xaml.cs). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="40,6,40,0">
            <TextBlock Text="Integrations" Style="{StaticResource PageTitle}"/>
            <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Games and apps IO Hub can react to. Each connection is something that happens there and what IO Hub does about it."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,24,0,0">
            <StackPanel x:Name="Sections" Margin="40,0,28,32" MaxWidth="820" HorizontalAlignment="Left"/>
        </ScrollViewer>
    </Grid>
</UserControl>
