<Window x:Class="IOHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IO Hub" Icon="/app.ico" Width="1240" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,0,14,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,18,0,26">
                    <!-- The DrangedAddons triangle in this app's colours (tools/make_icon.py) -->
                    <Image Source="/logo.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AppNameText" Text="IO Hub" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Setup switcher" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="11" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="10" Height="10" VerticalAlignment="Center">
                            <Ellipse Fill="{StaticResource SuccessBrush}" Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="2.2" Duration="0:0:1.6"/>
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="2.2" Duration="0:0:1.6"/>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.45" To="0" Duration="0:0:1.6"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="11,0,0,0">
                            <TextBlock Text="Watching devices" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock x:Name="UpdatedText" Text="Starting…" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel>
                    <TextBlock Text="SETUP" Style="{StaticResource Overline}" Margin="13,0,0,8"/>
                    <RadioButton x:Name="OverviewNav" Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Overview" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="DevicesNav" Style="{StaticResource NavItem}" Tag="&#xE772;" Content="Devices" Checked="Nav_Checked"/>
                    <RadioButton x:Name="ProfilesNav" Style="{StaticResource NavItem}" Tag="&#xE716;" Content="Profiles" Checked="Nav_Checked"/>
                    <RadioButton x:Name="TriggersNav" Style="{StaticResource NavItem}" Tag="&#xE945;" Content="Triggers" Checked="Nav_Checked"/>
                    <RadioButton x:Name="IntegrationsNav" Style="{StaticResource NavItem}" Tag="&#xE71B;" Content="Integrations" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE786;" IsEnabled="False">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="Soon" FontSize="10.5" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Scenes"/>
                        </DockPanel>
                    </RadioButton>

                    <TextBlock Text="APP" Style="{StaticResource Overline}" Margin="13,22,0,8"/>
                    <RadioButton x:Name="SettingsNav" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Settings" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Main ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False"/>

            <!-- Caption buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
